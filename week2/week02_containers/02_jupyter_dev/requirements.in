# Top-level dependencies only. Regenerate requirements.txt with:
#
#   pip install pip-tools
#   pip-compile --generate-hashes --output-file=requirements.txt requirements.in
#
# The generated requirements.txt pins every transitive dependency with
# its hash, giving you a reproducible build.

